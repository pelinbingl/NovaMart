@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- STAT CARDS -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-card-top">
            <div><div class="stat-label">Toplam Gelir</div><div class="stat-value">₺@(((decimal)ViewBag.TotalRevenue).ToString("N0"))</div></div>
            <div class="stat-icon" style="background:rgba(255,61,87,.12);color:var(--primary);"><i class="fas fa-lira-sign"></i></div>
        </div>
        <div class="stat-change up"><i class="fas fa-arrow-up"></i> Bu ay: ₺@(((decimal)ViewBag.MonthRevenue).ToString("N0"))</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-top">
            <div><div class="stat-label">Toplam Sipariş</div><div class="stat-value">@ViewBag.TotalOrders</div></div>
            <div class="stat-icon" style="background:rgba(0,212,170,.12);color:var(--accent);"><i class="fas fa-shopping-bag"></i></div>
        </div>
        <div class="stat-change warning" style="color:var(--warning);"><i class="fas fa-clock"></i> @ViewBag.PendingOrders bekleyen</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-top">
            <div><div class="stat-label">Aktif Ürün</div><div class="stat-value">@ViewBag.TotalProducts</div></div>
            <div class="stat-icon" style="background:rgba(124,58,237,.12);color:#7C3AED;"><i class="fas fa-box"></i></div>
        </div>
        <div class="stat-change down" style="color:var(--danger);"><i class="fas fa-exclamation-triangle"></i> @ViewBag.LowStockProducts düşük stok</div>
    </div>
    <div class="stat-card">
        <div class="stat-card-top">
            <div><div class="stat-label">Toplam Müşteri</div><div class="stat-value">@ViewBag.TotalCustomers</div></div>
            <div class="stat-icon" style="background:rgba(255,184,0,.12);color:var(--secondary);"><i class="fas fa-users"></i></div>
        </div>
        <div class="stat-change up"><i class="fas fa-arrow-up"></i> Bu ay: @ViewBag.NewCustomers yeni</div>
    </div>
</div>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:1.5rem;">

    <!-- SON SİPARİŞLER -->
    <div class="table-card">
        <div class="table-header">
            <span class="table-title">Son Siparişler</span>
            <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-secondary btn-sm">Tümünü Gör</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Sipariş No</th>
                    <th>Müşteri</th>
                    <th>Tutar</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in (IEnumerable<ECommerce.Models.Order>)ViewBag.RecentOrders)
                {
                    <tr>
                        <td style="font-family:monospace;font-size:.8rem;color:var(--accent);">@order.OrderNumber</td>
                        <td>@order.User?.FullName</td>
                        <td style="font-weight:700;">₺@order.Total.ToString("N0")</td>
                        <td>
                            @{
                                var (badgeClass, label) = order.Status switch {
                                    ECommerce.Models.OrderStatus.Delivered => ("badge-success", "Teslim"),
                                    ECommerce.Models.OrderStatus.Shipped   => ("badge-info", "Kargoda"),
                                    ECommerce.Models.OrderStatus.Paid      => ("badge-warning", "Hazırlanıyor"),
                                    ECommerce.Models.OrderStatus.Cancelled => ("badge-danger", "İptal"),
                                    _ => ("badge-muted", "Beklemede")
                                };
                            }
                            <span class="badge @badgeClass">@label</span>
                        </td>
                        <td style="color:var(--muted);font-size:.8rem;">@order.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Detail" asp-route-id="@order.Id"
                               class="btn btn-secondary btn-sm">Detay</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- EN ÇOK SATANLAR -->
    <div class="table-card">
        <div class="table-header">
            <span class="table-title">En Çok Satanlar</span>
        </div>
        <table>
            <thead><tr><th>Ürün</th><th>Satış</th></tr></thead>
            <tbody>
                @foreach (var p in (IEnumerable<ECommerce.Models.Product>)ViewBag.TopProducts)
                {
                    <tr>
                        <td>
                            <div style="display:flex;align-items:center;gap:.625rem;">
                                <span style="font-size:1.25rem;">@p.EmojiIcon</span>
                                <div>
                                    <div style="font-size:.8rem;font-weight:600;">@p.Name</div>
                                    <div style="font-size:.72rem;color:var(--muted);">@p.Brand</div>
                                </div>
                            </div>
                        </td>
                        <td style="font-weight:700;color:var(--primary);">@p.SalesCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
