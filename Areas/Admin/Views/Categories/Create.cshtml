@model ECommerce.Models.Category
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Kategori Düzenle" : "Yeni Kategori";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div style="display:flex;align-items:center;gap:.875rem;margin-bottom:1.5rem;">
    <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-secondary btn-sm"><i class="fas fa-arrow-left"></i></a>
    <h1 style="font-size:1.25rem;font-weight:700;">@ViewData["Title"]</h1>
</div>
<div class="form-card" style="max-width:560px;">
    <form asp-area="Admin" asp-controller="Categories" asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()
        @if (isEdit) { <input type="hidden" asp-for="Id" /> }
        <div class="form-grid">
            <div class="form-group full">
                <label class="form-label">Kategori Adı *</label>
                <input asp-for="Name" class="form-control" placeholder="Elektronik" required />
            </div>
            <div class="form-group">
                <label class="form-label">Slug</label>
                <input asp-for="Slug" class="form-control" placeholder="elektronik" />
            </div>
            <div class="form-group">
                <label class="form-label">Emoji İkon</label>
                <input asp-for="IconEmoji" class="form-control" placeholder="📱" />
            </div>
            <div class="form-group full">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Description" class="form-control" placeholder="Kategori açıklaması..."></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Sıra</label>
                <input asp-for="SortOrder" type="number" class="form-control" />
            </div>
            <div class="form-group" style="justify-content:flex-end;">
                <label class="form-check">
                    <input asp-for="IsActive" type="checkbox" />
                    <span>Aktif</span>
                </label>
            </div>
        </div>
        <div style="display:flex;gap:.75rem;margin-top:1.5rem;">
            <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @(isEdit ? "Güncelle" : "Kaydet")</button>
            <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>
