@model ECommerce.Models.Product
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni Ürün" : "Ürün Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    bool isEdit = Model.Id != 0;
}

<div style="display:flex;align-items:center;gap:.875rem;margin-bottom:1.5rem;">
    <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left"></i>
    </a>
    <h1 style="font-size:1.25rem;font-weight:700;">@ViewData["Title"]</h1>
</div>

<form asp-area="Admin" asp-controller="Products" asp-action="@(isEdit ? "Edit" : "Create")"
      method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" asp-for="Id" /> <input type="hidden" asp-for="Slug" /> }

    <div style="display:grid;grid-template-columns:2fr 1fr;gap:1.5rem;align-items:start;">

        <!-- LEFT -->
        <div style="display:flex;flex-direction:column;gap:1.25rem;">
            <div class="form-card">
                <h3 style="font-size:.9rem;font-weight:700;margin-bottom:1.25rem;">Temel Bilgiler</h3>
                <div class="form-grid">
                    <div class="form-group full">
                        <label class="form-label">Ürün Adı *</label>
                        <input asp-for="Name" class="form-control" placeholder="Ürün adını girin" required />
                        <span asp-validation-for="Name" style="color:var(--danger);font-size:.75rem;"></span>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Marka</label>
                        <input asp-for="Brand" class="form-control" placeholder="Örn: Apple" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">SKU / Barkod</label>
                        <input asp-for="SKU" class="form-control" placeholder="Stok kodu" />
                    </div>
                    <div class="form-group full">
                        <label class="form-label">Kısa Açıklama</label>
                        <input asp-for="ShortDescription" class="form-control" placeholder="Kısa tanıtım metni" />
                    </div>
                    <div class="form-group full">
                        <label class="form-label">Detaylı Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Ürün hakkında detaylı bilgi..."></textarea>
                    </div>
                </div>
            </div>

            <div class="form-card">
                <h3 style="font-size:.9rem;font-weight:700;margin-bottom:1.25rem;">Fiyat & Stok</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label class="form-label">Satış Fiyatı (₺) *</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="0.00" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Orijinal Fiyat (₺)</label>
                        <input asp-for="OriginalPrice" type="number" step="0.01" class="form-control" placeholder="İndirim öncesi fiyat" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Stok Adedi *</label>
                        <input asp-for="StockQuantity" type="number" class="form-control" placeholder="0" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Emoji İkon</label>
                        <input asp-for="EmojiIcon" class="form-control" placeholder="📱" />
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div style="display:flex;flex-direction:column;gap:1.25rem;">
            <div class="form-card">
                <h3 style="font-size:.9rem;font-weight:700;margin-bottom:1.25rem;">Kategori & Durum</h3>
                <div style="display:flex;flex-direction:column;gap:1rem;">
                    <div class="form-group">
                        <label class="form-label">Kategori *</label>
                        <select asp-for="CategoryId" class="form-control" required>
                            <option value="">Seçin...</option>
                            @foreach (var cat in (IEnumerable<ECommerce.Models.Category>)ViewBag.Categories)
                            {
                                <option value="@cat.Id">@cat.IconEmoji @cat.Name</option>
                            }
                        </select>
                    </div>
                    <label class="form-check">
                        <input asp-for="IsActive" type="checkbox" checked="@(Model.Id == 0 || Model.IsActive)" />
                        <span>Aktif (mağazada görünür)</span>
                    </label>
                    <label class="form-check">
                        <input asp-for="IsFeatured" type="checkbox" />
                        <span>Öne Çıkan Ürün</span>
                    </label>
                    <label class="form-check">
                        <input asp-for="IsNew" type="checkbox" />
                        <span>"Yeni" etiketi göster</span>
                    </label>
                </div>
            </div>

            <div class="form-card">
                <h3 style="font-size:.9rem;font-weight:700;margin-bottom:1.25rem;">Ürün Görseli</h3>
                @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                {
                    <img src="@Model.MainImageUrl" alt="Ürün görseli" style="width:100%;border-radius:10px;margin-bottom:1rem;object-fit:cover;" />
                }
                else
                {
                    <div style="aspect-ratio:1;background:var(--dark3);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:3rem;margin-bottom:1rem;">
                        @(Model.EmojiIcon ?? "📦")
                    </div>
                }
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                <p style="font-size:.72rem;color:var(--muted);margin-top:.5rem;">JPG, PNG, WEBP — maks 2MB</p>
            </div>

            <div style="display:flex;gap:.75rem;">
                <button type="submit" class="btn btn-primary" style="flex:1;justify-content:center;">
                    <i class="fas fa-save"></i> @(isEdit ? "Güncelle" : "Kaydet")
                </button>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-secondary">
                    İptal
                </a>
            </div>
        </div>
    </div>
</form>
