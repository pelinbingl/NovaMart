@model IEnumerable<ECommerce.Models.Order>
@{
    ViewData["Title"] = "Siparişler";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
    <h1 style="font-size:1.25rem;font-weight:700;">Sipariş Yönetimi</h1>
</div>

<div class="table-card">
    <table>
        <thead>
            <tr>
                <th>Sipariş No</th>
                <th>Müşteri</th>
                <th>Ürünler</th>
                <th>Toplam</th>
                <th>Ödeme</th>
                <th>Durum</th>
                <th>Tarih</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td style="font-family:monospace;font-size:.8rem;color:var(--accent);">@order.OrderNumber</td>
                    <td>
                        <div style="font-weight:600;font-size:.875rem;">@order.User?.FullName</div>
                        <div style="font-size:.72rem;color:var(--muted);">@order.User?.Email</div>
                    </td>
                    <td style="font-size:.8rem;color:var(--muted);">@order.Items.Count ürün</td>
                    <td style="font-weight:700;">₺@order.Total.ToString("N0")</td>
                    <td>
                        @{
                            var (pc, pl) = order.PaymentStatus switch {
                                ECommerce.Models.PaymentStatus.Success  => ("badge-success", "Ödendi"),
                                ECommerce.Models.PaymentStatus.Failed   => ("badge-danger", "Başarısız"),
                                ECommerce.Models.PaymentStatus.Refunded => ("badge-info", "İade"),
                                _ => ("badge-muted", "Bekliyor")
                            };
                        }
                        <span class="badge @pc">@pl</span>
                    </td>
                    <td>
                        @{
                            var (sc, sl) = order.Status switch {
                                ECommerce.Models.OrderStatus.Delivered => ("badge-success", "Teslim"),
                                ECommerce.Models.OrderStatus.Shipped   => ("badge-info", "Kargoda"),
                                ECommerce.Models.OrderStatus.Paid      => ("badge-warning", "Hazırlanıyor"),
                                ECommerce.Models.OrderStatus.Cancelled => ("badge-danger", "İptal"),
                                _ => ("badge-muted", "Bekliyor")
                            };
                        }
                        <span class="badge @sc">@sl</span>
                    </td>
                    <td style="color:var(--muted);font-size:.8rem;">@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-area="Admin" asp-controller="Orders" asp-action="Detail" asp-route-id="@order.Id"
                           class="btn btn-secondary btn-sm">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
