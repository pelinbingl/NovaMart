@model ECommerce.Models.Order
@{
    ViewData["Title"] = "Sipariş Onaylandı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div style="min-height:calc(100vh - 72px);display:flex;align-items:center;justify-content:center;padding:3rem 1rem;">
    <div style="text-align:center;max-width:500px;">
        <div style="width:80px;height:80px;background:rgba(0,212,170,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2.5rem;margin:0 auto 1.5rem;">✅</div>
        <h1 style="font-size:2rem;font-weight:700;letter-spacing:-1px;margin-bottom:.75rem;">Siparişin Alındı!</h1>
        <p style="color:var(--muted);margin-bottom:2rem;">Siparişin başarıyla oluşturuldu. Kargo takip numarasını e-posta ile göndereceğiz.</p>
        <div style="background:var(--dark2);border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:1.5rem;margin-bottom:2rem;text-align:left;">
            <div style="display:flex;justify-content:space-between;margin-bottom:.75rem;font-size:.875rem;"><span style="color:var(--muted);">Sipariş No</span><span style="font-family:monospace;color:var(--accent);">@Model.OrderNumber</span></div>
            <div style="display:flex;justify-content:space-between;font-size:.875rem;"><span style="color:var(--muted);">Toplam</span><span style="font-weight:700;color:var(--primary);">₺@Model.Total.ToString("N0")</span></div>
        </div>
        <div style="display:flex;gap:1rem;justify-content:center;">
            <a asp-controller="Order" asp-action="MyOrders" style="background:linear-gradient(135deg,#FF3D57,#FF8C42);color:white;border:none;border-radius:10px;padding:.75rem 1.5rem;font-weight:700;font-size:.9rem;">Siparişlerimi Gör</a>
            <a asp-controller="Home" asp-action="Index" style="background:var(--dark2);color:white;border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:.75rem 1.5rem;font-weight:600;font-size:.9rem;">Alışverişe Devam</a>
        </div>
    </div>
</div>
