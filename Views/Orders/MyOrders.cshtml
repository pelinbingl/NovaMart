@model IEnumerable<ECommerce.Models.Order>
@{
    ViewData["Title"] = "Siparişlerim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div style="max-width:900px;margin:0 auto;padding:2.5rem 2rem;">
    <h1 style="font-size:1.75rem;font-weight:700;letter-spacing:-1px;margin-bottom:2rem;">Siparişlerim</h1>
    @if (!Model.Any())
    {
        <div class="empty-state"><div class="empty-state-icon">📦</div><h3>Henüz siparişin yok</h3><p>İlk siparişini vermek için alışverişe başla.</p><a asp-controller="Home" asp-action="Index" class="btn-primary">Alışverişe Başla</a></div>
    }
    @foreach (var order in Model)
    {
        <div style="background:var(--dark2);border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:1.5rem;margin-bottom:1rem;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
                <div>
                    <span style="font-family:monospace;color:var(--accent);font-size:.875rem;">@order.OrderNumber</span>
                    <span style="color:var(--muted);font-size:.78rem;margin-left:1rem;">@order.CreatedAt.ToString("dd MMMM yyyy")</span>
                </div>
                @{
                    var (bc, bl) = order.Status switch {
                        ECommerce.Models.OrderStatus.Delivered => ("badge-success","Teslim Edildi"),
                        ECommerce.Models.OrderStatus.Shipped   => ("badge-info","Kargoda"),
                        ECommerce.Models.OrderStatus.Paid      => ("badge-warning","Hazırlanıyor"),
                        ECommerce.Models.OrderStatus.Cancelled => ("badge-danger","İptal"),
                        _ => ("badge-muted","Beklemede")
                    };
                }
                <span class="badge @bc">@bl</span>
            </div>
            <div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1rem;">
                @foreach (var item in order.Items)
                {
                    <div style="background:var(--dark3);border-radius:8px;padding:.375rem .625rem;font-size:.78rem;display:flex;align-items:center;gap:.375rem;">
                        <span>@item.ProductEmoji</span><span>@item.ProductName</span><span style="color:var(--muted);">x@item.Quantity</span>
                    </div>
                }
            </div>
            <div style="display:flex;align-items:center;justify-content:space-between;">
                <span style="font-weight:700;color:var(--primary);">₺@order.Total.ToString("N0")</span>
                <a asp-controller="Order" asp-action="Detail" asp-route-id="@order.Id" style="font-size:.8rem;color:var(--primary);">Detay →</a>
            </div>
        </div>
    }
</div>
