@model ECommerce.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="min-height:calc(100vh - 72px);display:flex;align-items:center;justify-content:center;padding:3rem 1rem;">
    <div style="width:100%;max-width:480px;">
        <div style="text-align:center;margin-bottom:2rem;">
            <h1 style="font-size:2rem;font-weight:700;letter-spacing:-1px;">Hesap Oluştur</h1>
            <p style="color:var(--muted);margin-top:.5rem;">NovaMart ailesine katıl</p>
        </div>

        <div style="background:var(--dark2);border:1px solid rgba(255,255,255,.06);border-radius:20px;padding:2rem;">
            <form asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" style="background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.2);border-radius:10px;padding:.875rem 1rem;margin-bottom:1.25rem;font-size:.875rem;color:#EF4444;display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
                    <div>
                        <label style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);display:block;margin-bottom:.4rem;">Ad</label>
                        <input asp-for="FirstName" style="width:100%;background:var(--dark3);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:.625rem .875rem;color:white;font-size:.875rem;outline:none;font-family:inherit;" placeholder="Adın" />
                    </div>
                    <div>
                        <label style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);display:block;margin-bottom:.4rem;">Soyad</label>
                        <input asp-for="LastName" style="width:100%;background:var(--dark3);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:.625rem .875rem;color:white;font-size:.875rem;outline:none;font-family:inherit;" placeholder="Soyadın" />
                    </div>
                </div>

                @{
                    void Field(string forAttr, string label, string inputType, string placeholder) {
                        <div style="margin-bottom:1rem;">
                            <label style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);display:block;margin-bottom:.4rem;">@label</label>
                            <input name="@forAttr" type="@inputType" style="width:100%;background:var(--dark3);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:.625rem .875rem;color:white;font-size:.875rem;outline:none;font-family:inherit;" placeholder="@placeholder" />
                        </div>
                    }
                }
                @{ Field("Email", "E-posta", "email", "ornek@email.com"); }
                @{ Field("PhoneNumber", "Telefon", "tel", "0532 000 00 00"); }
                @{ Field("Password", "Şifre", "password", "En az 6 karakter"); }
                @{ Field("ConfirmPassword", "Şifre Tekrar", "password", "Şifreni tekrar gir"); }

                <button type="submit" style="width:100%;background:linear-gradient(135deg,#FF3D57,#FF8C42);color:white;border:none;border-radius:10px;padding:.875rem;font-size:1rem;font-weight:700;cursor:pointer;margin-top:.5rem;font-family:inherit;">
                    Kayıt Ol
                </button>
            </form>

            <p style="text-align:center;margin-top:1.5rem;font-size:.875rem;color:var(--muted);">
                Zaten hesabın var mı?
                <a asp-controller="Account" asp-action="Login" style="color:var(--primary);font-weight:600;">Giriş Yap</a>
            </p>
        </div>
    </div>
</div>
