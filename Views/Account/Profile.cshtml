@model ECommerce.Models.ApplicationUser
@{
    ViewData["Title"] = "Hesabım";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div style="max-width:800px;margin:0 auto;padding:2.5rem 2rem;">
    <h1 style="font-size:1.75rem;font-weight:700;letter-spacing:-1px;margin-bottom:2rem;">Hesabım</h1>

    <!-- TABS -->
    <div class="tabs">
        <div class="tab active" onclick="switchTab(this,'profile')">Profil Bilgileri</div>
        <div class="tab" onclick="switchTab(this,'password')">Şifre Değiştir</div>
        <div class="tab" onclick="window.location='/Order/MyOrders'">Siparişlerim</div>
    </div>

    <!-- PROFILE TAB -->
    <div id="tab-profile">
        <div style="background:var(--dark2);border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:2rem;">
            <div style="display:flex;align-items:center;gap:1.5rem;margin-bottom:2rem;padding-bottom:2rem;border-bottom:1px solid rgba(255,255,255,.06);">
                <div style="width:72px;height:72px;background:linear-gradient(135deg,#FF3D57,#FFB800);border-radius:18px;display:flex;align-items:center;justify-content:center;font-size:1.75rem;font-weight:700;flex-shrink:0;">
                    @Model.FirstName.FirstOrDefault()
                </div>
                <div>
                    <h2 style="font-size:1.1rem;font-weight:700;">@Model.FullName</h2>
                    <p style="color:var(--muted);font-size:.875rem;margin-top:.2rem;">@Model.Email</p>
                    <p style="color:var(--muted);font-size:.78rem;margin-top:.2rem;">Üyelik: @Model.CreatedAt.ToString("dd MMMM yyyy")</p>
                </div>
            </div>

            <form asp-controller="Account" asp-action="UpdateProfile" method="post">
                @Html.AntiForgeryToken()
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem;">
                    @{
                        void PField(string name, string label, string value, string inputType = "text") {
                            <div>
                                <label style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);display:block;margin-bottom:.4rem;">@label</label>
                                <input name="@name" type="@inputType" value="@value" style="width:100%;background:var(--dark3);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:.625rem .875rem;color:white;font-size:.875rem;outline:none;font-family:inherit;" />
                            </div>
                        }
                    }
                    @{ PField("firstName", "Ad", Model.FirstName); }
                    @{ PField("lastName", "Soyad", Model.LastName); }
                    @{ PField("phoneNumber", "Telefon", Model.PhoneNumber ?? "", "tel"); }
                    <div>
                        <label style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);display:block;margin-bottom:.4rem;">E-posta</label>
                        <input type="email" value="@Model.Email" disabled style="width:100%;background:var(--dark3);border:1px solid rgba(255,255,255,.05);border-radius:10px;padding:.625rem .875rem;color:var(--muted);font-size:.875rem;font-family:inherit;" />
                    </div>
                </div>
                <button type="submit" style="background:linear-gradient(135deg,#FF3D57,#FF8C42);color:white;border:none;border-radius:10px;padding:.75rem 2rem;font-size:.9rem;font-weight:700;cursor:pointer;font-family:inherit;">
                    <i class="fas fa-save"></i> Kaydet
                </button>
            </form>
        </div>
    </div>

    <!-- PASSWORD TAB -->
    <div id="tab-password" style="display:none;">
        <div style="background:var(--dark2);border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:2rem;max-width:400px;">
            <form asp-controller="Account" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                @{
                    void PwField(string name, string label) {
                        <div style="margin-bottom:1rem;">
                            <label style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);display:block;margin-bottom:.4rem;">@label</label>
                            <input name="@name" type="password" style="width:100%;background:var(--dark3);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:.625rem .875rem;color:white;font-size:.875rem;outline:none;font-family:inherit;" placeholder="••••••••" />
                        </div>
                    }
                }
                @{ PwField("currentPassword", "Mevcut Şifre"); }
                @{ PwField("newPassword", "Yeni Şifre"); }
                @{ PwField("confirmPassword", "Yeni Şifre Tekrar"); }
                <button type="submit" style="background:linear-gradient(135deg,#FF3D57,#FF8C42);color:white;border:none;border-radius:10px;padding:.75rem 2rem;font-size:.9rem;font-weight:700;cursor:pointer;font-family:inherit;">
                    Şifreyi Değiştir
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
function switchTab(el, id) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    ['profile','password'].forEach(t => {
        const el = document.getElementById('tab-' + t);
        if (el) el.style.display = t === id ? '' : 'none';
    });
}
</script>
}
