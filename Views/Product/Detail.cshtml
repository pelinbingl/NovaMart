@{
    ViewData["Title"] = "Ürün Detay";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- BREADCRUMB -->
<div class="breadcrumb">
    <a asp-controller="Home" asp-action="Index">Anasayfa</a>
    <span class="sep">/</span>
    <a asp-controller="Category" asp-action="Index">Elektronik</a>
    <span class="sep">/</span>
    <span class="current">Samsung Galaxy S24 Ultra</span>
</div>

<!-- PRODUCT DETAIL LAYOUT -->
<div class="product-detail">

    <!-- GALLERY -->
    <div class="detail-gallery">
        <div class="detail-main-img" id="mainImg">
            <span id="mainEmoji" style="transition:all .3s ease;">📱</span>
        </div>
        <div class="detail-thumbs">
            @{
                var thumbs = new[] { ("📱","Ön Yüz"), ("🔋","Arka Yüz"), ("📡","Detay"), ("🎨","Renk") };
            }
            @foreach (var (icon, label) in thumbs)
            {
                <div class="detail-thumb @(icon == "📱" ? "active" : "")"
                     onclick="switchImg(this, '@icon')" title="@label">
                    @icon
                </div>
            }
        </div>
    </div>

    <!-- INFO -->
    <div class="detail-info">
        <div class="detail-brand">Samsung</div>
        <h1 class="detail-name">Galaxy S24 Ultra 512GB</h1>

        <div class="detail-rating">
            <span class="stars" style="font-size:.95rem;">★★★★★</span>
            <span class="detail-rating-num">4.8</span>
            <span style="color:var(--muted);font-size:.875rem;">/ 5</span>
            <a href="#reviews" class="review-link">(2.147 değerlendirme)</a>
        </div>

        <div class="detail-price-row">
            <span class="detail-price">₺45.999</span>
            <span class="detail-price-old">₺52.999</span>
            <span class="detail-discount">%13 İndirim</span>
        </div>

        <p class="detail-desc">
            Galaxy S24 Ultra, gelişmiş yapay zeka özellikleri ve güçlü performansıyla profesyonel kullanıcılar için tasarlanmış amiral gemisi akıllı telefon. 200MP kamera, 6.8" Dynamic AMOLED 2X ekran ve dahili S Pen ile fark yarat.
        </p>

        <!-- STORAGE -->
        <div class="option-group">
            <div class="option-label">Depolama</div>
            <div class="size-options">
                <button class="size-btn" onclick="selectOption(this, 'storage')">256GB</button>
                <button class="size-btn active" onclick="selectOption(this, 'storage')">512GB</button>
                <button class="size-btn" onclick="selectOption(this, 'storage')">1TB</button>
            </div>
        </div>

        <!-- COLOR -->
        <div class="option-group">
            <div class="option-label">Renk: <span id="selectedColor" style="color:var(--white);font-weight:600;">Titanium Black</span></div>
            <div class="color-options">
                <div class="color-btn active" style="background:#1a1a1a;" onclick="selectColor(this,'Titanium Black')" title="Titanium Black"></div>
                <div class="color-btn" style="background:#e8e0d0;" onclick="selectColor(this,'Titanium Beige')" title="Titanium Beige"></div>
                <div class="color-btn" style="background:#8B7355;" onclick="selectColor(this,'Titanium Brown')" title="Titanium Brown"></div>
                <div class="color-btn" style="background:#4A5568;" onclick="selectColor(this,'Titanium Gray')" title="Titanium Gray"></div>
            </div>
        </div>

        <!-- QTY -->
        <div class="qty-row">
            <div class="option-label" style="margin-bottom:0;">Adet:</div>
            <div class="qty-control">
                <button class="qty-btn" onclick="changeQty(-1)">−</button>
                <div class="qty-num" id="qtyNum">1</div>
                <button class="qty-btn" onclick="changeQty(1)">+</button>
            </div>
            <span style="font-size:.8rem;color:var(--muted);">Stokta: 47 adet</span>
        </div>

        <!-- ACTIONS -->
        <div class="detail-actions">
            <button class="btn-primary btn-cart" onclick="addToCart('Samsung Galaxy S24 Ultra')">
                <i class="fas fa-shopping-bag"></i> Sepete Ekle
            </button>
            <button class="btn-secondary btn-wish" onclick="showToast('❤️ Favorilere eklendi!')">
                <i class="far fa-heart"></i>
            </button>
            <button class="btn-secondary btn-wish">
                <i class="fas fa-share-alt"></i>
            </button>
        </div>

        <!-- META -->
        <div class="detail-meta">
            <div class="meta-item">
                <span class="meta-icon">🚚</span>
                <span><strong>Ücretsiz Kargo</strong> — Siparişler 500₺ üzeri</span>
            </div>
            <div class="meta-item">
                <span class="meta-icon">↩️</span>
                <span><strong>30 Gün İade</strong> — Koşulsuz iade garantisi</span>
            </div>
            <div class="meta-item">
                <span class="meta-icon">🔒</span>
                <span><strong>Güvenli Ödeme</strong> — 256-bit SSL şifreleme</span>
            </div>
            <div class="meta-item">
                <span class="meta-icon">🏷️</span>
                <span><strong>2 Yıl Garanti</strong> — Yetkili servis güvencesi</span>
            </div>
        </div>
    </div>
</div>

<!-- TABS: AÇIKLAMA / ÖZELLİKLER / YORUMLAR -->
<div class="section" style="padding-top:0;">
    <div class="tabs">
        <div class="tab active" onclick="switchTab(this,'desc')">Ürün Açıklaması</div>
        <div class="tab" onclick="switchTab(this,'specs')">Özellikler</div>
        <div class="tab" onclick="switchTab(this,'reviews')" id="reviews">Değerlendirmeler (2147)</div>
    </div>

    <div id="tab-desc">
        <p style="color:var(--muted);line-height:1.9;max-width:760px;font-size:.95rem;">
            Samsung Galaxy S24 Ultra, serinin en güçlü ve en gelişmiş üyesidir. Yeni nesil Snapdragon 8 Gen 3 işlemci ile olağanüstü performans sunan bu cihaz, Galaxy AI özellikleriyle yapay zekayı akıllı telefonunuza taşıyor. Gece çekimlerinde bile kristal netliğinde fotoğraflar elde edin, S Pen ile notlarınızı dijitalleştirin ve 5000 mAh pil kapasitesiyle tüm gün kesintisiz kullanın.
        </p>
    </div>

    <div id="tab-specs" style="display:none;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem;max-width:600px;">
            @{
                var specs = new[] {
                    ("İşlemci","Snapdragon 8 Gen 3"),
                    ("RAM","12 GB"),
                    ("Depolama","512 GB"),
                    ("Ekran","6.8\" Dynamic AMOLED 2X"),
                    ("Kamera","200 MP + 10 MP + 10 MP + 12 MP"),
                    ("Ön Kamera","12 MP"),
                    ("Pil","5000 mAh"),
                    ("Şarj","45W + Kablosuz 15W"),
                    ("İşletim Sistemi","Android 14, One UI 6.1"),
                    ("Ağırlık","232 g"),
                };
            }
            @foreach (var (label, val) in specs)
            {
                <div style="background:var(--dark2);border:1px solid rgba(255,255,255,.05);border-radius:10px;padding:.75rem 1rem;">
                    <div style="font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:.25rem;">@label</div>
                    <div style="font-weight:600;font-size:.9rem;">@val</div>
                </div>
            }
        </div>
    </div>

    <div id="tab-reviews" style="display:none;">
        @{
            var reviews = new[] {
                ("Ahmet Y.", "5", "Mükemmel bir telefon! Kamerası inanılmaz, özellikle gece çekimlerinde çok başarılı.", "2 gün önce"),
                ("Selin K.", "4", "Genel olarak çok memnunum ama biraz ağır. Fiyat/performans açısından değer.", "1 hafta önce"),
                ("Murat D.", "5", "S Pen özelliği iş hayatımı kolaylaştırdı. Kesinlikle tavsiye ederim.", "2 hafta önce"),
            };
        }
        <div style="display:grid;gap:1rem;max-width:700px;">
            @foreach (var (name, stars, text, date) in reviews)
            {
                <div style="background:var(--dark2);border:1px solid rgba(255,255,255,.06);border-radius:16px;padding:1.25rem;">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.75rem;">
                        <div style="display:flex;align-items:center;gap:.625rem;">
                            <div style="width:38px;height:38px;background:var(--gradient-hero);border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.875rem;">
                                @name[0]
                            </div>
                            <div>
                                <div style="font-weight:600;font-size:.9rem;">@name</div>
                                <div style="font-size:.75rem;color:var(--muted);">@date</div>
                            </div>
                        </div>
                        <span class="stars">@string.Concat(Enumerable.Repeat("★", int.Parse(stars)))</span>
                    </div>
                    <p style="color:var(--muted);font-size:.875rem;line-height:1.7;">@text</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
function switchImg(el, emoji) {
    document.querySelectorAll('.detail-thumb').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('mainEmoji').style.transform = 'scale(0.8)';
    document.getElementById('mainEmoji').style.opacity = '0';
    setTimeout(() => {
        document.getElementById('mainEmoji').textContent = emoji;
        document.getElementById('mainEmoji').style.transform = 'scale(1)';
        document.getElementById('mainEmoji').style.opacity = '1';
    }, 150);
}

function selectOption(el, group) {
    el.closest('.size-options').querySelectorAll('.size-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
}

function selectColor(el, name) {
    document.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('selectedColor').textContent = name;
}

let qty = 1;
function changeQty(dir) {
    qty = Math.max(1, qty + dir);
    document.getElementById('qtyNum').textContent = qty;
}

function switchTab(el, id) {
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    el.classList.add('active');
    ['desc','specs','reviews'].forEach(t => {
        document.getElementById('tab-' + t).style.display = t === id ? '' : 'none';
    });
}
</script>
}
